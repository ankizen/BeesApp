# --- Core ---
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=https://api.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com

# --- Database ---
POSTGRES_USER=content_hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=content_hub
DATABASE_URL=postgresql://content_hub:change-me@postgres:5432/content_hub?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Encryption (generate with: openssl rand -hex 32, must be exactly 32 bytes / 64 hex chars) ---
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Webhook ---
WEBHOOK_MAX_BODY_BYTES=2000000

# --- Facebook ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://api.yourdomain.com/api/facebook/callback

# --- Threads ---
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://api.yourdomain.com/api/threads/callback

# --- Seed (first run only) ---
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-immediately

# --- Frontend build-time ---
VITE_API_URL=https://api.yourdomain.com
